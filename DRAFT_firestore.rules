rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) 
             && data.keys().size() >= 3 
             && data.email is string 
             && data.email.size() <= 256;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['productIds', 'updatedAt']) 
             && data.productIds is list 
             && data.productIds.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
                     && isValidId(userId)
                     && isValidUser(incoming())
                     && incoming().createdAt == request.time
                     && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                     && isValidUser(incoming())
                     && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
                     && incoming().updatedAt == request.time;
      allow delete: if false;

      match /data/wishlist {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
                         && isValidWishlist(incoming())
                         && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
                         && isValidWishlist(incoming())
                         && incoming().diff(existing()).affectedKeys().hasOnly(['productIds', 'updatedAt'])
                         && incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
