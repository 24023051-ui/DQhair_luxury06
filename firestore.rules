rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'admin@dqhairvn.com' 
        || request.auth.token.email == '24023051@vnu.edu.vn'
        || request.auth.token.email.matches('.*admin.*')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt', 'updatedAt']) 
             && data.email is string 
             && data.email.size() <= 256
             && data.name is string
             && data.name.size() <= 128;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['productIds', 'updatedAt']) 
             && data.productIds is list 
             && data.productIds.size() <= 100;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'slug', 'description', 'category', 'images', 'details', 'createdAt', 'updatedAt'])
             && data.name is string && data.name.size() <= 128
             && data.slug is string && data.slug.size() <= 128
             && data.description is string && data.description.size() <= 2048
             && data.category is string && data.category.size() <= 64
             && data.images is list && data.images.size() <= 20
             && data.details is string && data.details.size() <= 4096
             && (!data.keys().hasAny(['videoUrls']) || (data.videoUrls is list && data.videoUrls.size() <= 10))
             && (!data.keys().hasAny(['videoUrl']) || (data.videoUrl is string && data.videoUrl.size() <= 1024));
    }

    match /admins/{userId} {
      allow get: if isSignedIn();
      allow read: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() 
                    && isValidId(productId)
                    && isValidProduct(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isAdmin()
                    && isValidProduct(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'category', 'images', 'details', 'videoUrl', 'videoUrls', 'updatedAt'])
                    && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
                     && isValidId(userId)
                     && isValidUser(incoming())
                     && incoming().createdAt == request.time
                     && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                     && isValidUser(incoming())
                     && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
                     && incoming().updatedAt == request.time;
      allow delete: if false;

      match /data/wishlist {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
                         && isValidWishlist(incoming())
                         && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
                         && isValidWishlist(incoming())
                         && incoming().diff(existing()).affectedKeys().hasOnly(['productIds', 'updatedAt'])
                         && incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
